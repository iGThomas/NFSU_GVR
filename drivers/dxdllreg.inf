[Version]
Signature="$CHICAGO$"
AdvancedINF=2.0
Provider = %Msft%

[DestinationDirs]
DXWININITBAK=10

[DXDllRegister]
DirectShow
DirectSound
DirectPlay
DirectInput
DxDiag

[DXDllUnRegister]
UnDirectSound
UnDirectPlay
UnDX8DebugDLLs
DX8RetailDLLs
UnDirectInput
UnDxDiag

[DXRenFiles]
RenFiles=DXWININITBAK

[DXWININITBAK]
wininit.sav,wininit.bak

[DX8RetailDLLs]
RegisterOCXs=DirectX8_Retail

[UnDX8RetailDLLs]
UnregisterOCXs=DirectX8_Retail

[DX8DebugDLLs]
RegisterOCXs=DirectX8_Debug

[UnDX8DebugDLLs]
UnregisterOCXs=DirectX8_Debug

[DirectX8_Retail]
%11%\dinput8.dll
%11%\dmband.dll
%11%\dmcompos.dll
%11%\dmime.dll
%11%\dmloader.dll
%11%\dmscript.dll
%11%\dmstyle.dll
%11%\dmsynth.dll
%11%\dmusic.dll
%11%\dpnet.dll
%11%\dpnhupnp.dll
%11%\dpnhpast.dll
%11%\dpvacm.dll
%11%\dpvoice.dll
%11%\dpvvox.dll
%11%\dswave.dll

[DirectX8_Debug]
%11%\dinput8d.dll
%11%\dmbandd.dll
%11%\dmcompod.dll
%11%\dmimed.dll
%11%\dmloaded.dll
%11%\dmscripd.dll
%11%\dmstyled.dll
%11%\dmsynthd.dll
%11%\dmusicd.dll
%11%\dpnetd.dll
%11%\dpnhupnpd.dll
%11%\dpnhpastd.dll
%11%\dpvacmd.dll
%11%\dpvoiced.dll
%11%\dpvvoxd.dll
%11%\dswaved.dll

[D3D_Retail]
HKLM,SOFTWARE\Microsoft\Direct3D,"LoadDebugRuntime",0x00010001,0x00000000

[D3D_Debug]
HKLM,SOFTWARE\Microsoft\Direct3D,"LoadDebugRuntime",0x00010001,0x00000001

[DirectSound]
RegisterOCXs=DSound_RegisterDll

[UnDirectSound]
UnregisterOCXs=DSound_RegisterDll

[DSound_RegisterDll]
%11%\dsdmo.dll

[DirectShow]
RegisterOCXs=DShow_RegisterDll

[UnDirectShow]
UnregisterOCXs=DShow_RegisterDll

[DShow_RegisterDll]
%11%\amstream.dll
%11%\devenum.dll
%11%\encapi.dll
%11%\mswebdvd.dll
%11%\qasf.dll
%11%\qcap.dll
%11%\qdv.dll
%11%\qdvd.dll
%11%\qedit.dll
%11%\quartz.dll
%11%\l3codecx.ax
%11%\mpg2splt.ax

[DXTrans]
RegisterOCXs=DXTrans_RegisterDll

[UnDXTrans]
UnregisterOCXs=DXTrans_RegisterDll

[DXTrans_RegisterDll]
%11%\dxtrans.dll
%11%\dxtmsft.dll

[DirectInput]
RegisterOCXs=DINPUT_RegisterDll

[UnDirectInput]
UnregisterOCXs=DINPUT_RegisterDll

[DINPUT_RegisterDll]
%11%\dinput.dll

[DirectPlay]
RegisterOCXs=DPLAY_RegisterDll

[UnDirectPlay]
UnregisterOCXs=DPLAY_RegisterDll

[DPLAY_RegisterDll]
%11%\dplayx.dll

[DxDiag]
RegisterOCXs=DXDIAG_RegisterDll

[UnDxDiag]
UnregisterOCXs=DXDIAG_RegisterDll

[DXDIAG_RegisterDll]
%11%\dxdiagn.dll

[Strings]
Msft                 = "Microsoft"

