LIBRARY dsound
; Ordinals MUST match the real dsound.dll exactly: both NFSU executables import by
; ORDINAL (UniverShell2 -> @11, UndergroundGVR -> @1 and @11), not by name.
EXPORTS
    DirectSoundCreate            @1
    DirectSoundEnumerateA        @2
    DirectSoundEnumerateW        @3
    DllCanUnloadNow              @4
    DllGetClassObject            @5
    DirectSoundCaptureCreate     @6
    DirectSoundCaptureEnumerateA @7
    DirectSoundCaptureEnumerateW @8
    GetDeviceID                  @9
    DirectSoundFullDuplexCreate  @10
    DirectSoundCreate8           @11
    DirectSoundCaptureCreate8    @12
